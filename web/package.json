{
  "name": "wingspan-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p e2e-wdio/tsconfig.json",
    "lint": "oxlint",
    "test": "vitest",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:wdio": "wdio run wdio.conf.ts",
    "screenshots": "node e2e/support/capture-screenshots.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2.11.1",
    "echarts": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.0",
    "@wdio/cli": "9.31.5",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.5",
    "@wdio/mocha-framework": "9.31.5",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-service": "1.3.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webdriverio": "9.31.5"
  }
}
