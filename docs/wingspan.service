# User unit: runs as your login (needs `loginctl enable-linger` to survive
# logout / start at boot). For an always-on server prefer the system-wide
# `docs/wingspan-system.service`; the step-by-step lives in docs/DEPLOY.md.

[Unit]
Description=Wingspan options dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/wingspan serve --config %h/.config/wingspan/wingspan.toml
# The bind and its gate live in wingspan.toml, not here. Beyond loopback the
# service refuses to start without `[server] allow_remote` plus `lan_only` or
# `auth_token`; DEPLOY.md's "Behind HAProxy on the LAN" has the whole config.
Restart=always
RestartSec=5
Environment=RUST_LOG=info
# Schwab app credentials, if used (or use a drop-in / EnvironmentFile):
# EnvironmentFile=%h/.config/wingspan/schwab.env
# Everything the service creates (snapshot cache, the uploaded trade snapshot)
# is private to the user; the upload is deleted again when the user clears it.
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/wingspan %h/.config/wingspan
# The Schwab token file is read-only to wingspan (other applications own it),
# so it never belongs above. It is already readable wherever it lives
# (ProtectSystem=strict only removes write access); pinning its directory
# read-only is optional belt-and-braces, never write access:
# ReadOnlyPaths=/srv/schwab
PrivateTmp=true

[Install]
WantedBy=default.target
