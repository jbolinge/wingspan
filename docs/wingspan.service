# User unit: runs as your login (needs `loginctl enable-linger` to survive
# logout / start at boot). For an always-on server prefer the system-wide
# `docs/wingspan-system.service`; the step-by-step lives in docs/DEPLOY.md.

[Unit]
Description=Wingspan options dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/wingspan serve --config %h/.config/wingspan/wingspan.toml
Restart=always
RestartSec=5
Environment=RUST_LOG=info
# Schwab app credentials, if used (or use a drop-in / EnvironmentFile):
# EnvironmentFile=%h/.config/wingspan/schwab.env
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/wingspan %h/.config/wingspan
# The Schwab token file is read-only to wingspan (other applications own it),
# so it never belongs above. Outside the home dir, grant read access only:
# ReadOnlyPaths=/srv/schwab
PrivateTmp=true

[Install]
WantedBy=default.target
